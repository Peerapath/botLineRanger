# Captured traffic contains session tokens and account identifiers - never commit it.
captures/
*.jsonl
*.mitm

__pycache__/
*.pyc

# Account records and sessions hold LF_AC / userToken - never commit them.
roster/accounts/
roster/scratch/
roster/*.json
id/*.xml
bot/output/*.xml
bot/backup/*.xml
# Frida captures contain the live appSecret and cookies.
tools/frida/*.capture.txt

# Build-time secret tool: holds plaintext master_password/api_url. Keep local only.
bot/encrypt_config.py

# Relogin batch: account inputs, backups, and its log all carry live LF_AC.
bot/input/
*_backup/
*.relogin.csv

# Shared rate-limit bucket/lock files written by workers at runtime (repo root / next to the exe).
.ratelimit/

# Build output. dist_pyarmor holds obfuscated copies of every source file, so committing it
# would ship the same code twice and rot the moment the originals change.
bot/build/
bot/dist/
bot/dist_pyarmor/
bot/Version/
# Holds the real signing key server_version.py uses during build.bat.
bot/.build_env

# Runtime state, not source: accounts mid-flight, the worker's file claims, and its logs.
bot/execute/
bot/login failed/
bot/src/log/
bot/src/split-ID/
# The user's own config carries their licence email; default_config/ is the tracked copy.
bot/src/config.ini
bot/src/configRangers.ini
bot/src/configGears.ini

# Bundled third-party binaries pulled in by the build, not authored here.
bot/src/Tesseract-OCR/
bot/src/adb/
# Screen-match templates for the ADB automation; megabytes of PNG that no API mode reads.
bot/src/image/

# One-off captures kept next to the code while reversing an endpoint.
bot/enter_dump.json
tools/lfac_probe.txt

# Local Claude Code profile for the qwen gateway - holds a live ANTHROPIC_AUTH_TOKEN.
.claude-9arm.json
# Written by the engine at runtime (client_version learns App-Version / prefix) - state, not source.
bot/src/api_version.json
# PyArmor crash reports.
*.bug.log
