# Captured traffic contains session tokens and account identifiers - never commit it.
captures/
*.jsonl
*.mitm

__pycache__/
*.pyc

# Account records and sessions hold LF_AC / userToken - never commit them.
roster/accounts/
roster/scratch/
roster/*.json
id/*.xml
bot/output/*.xml
bot/backup/*.xml
# Frida captures contain the live appSecret and cookies.
tools/frida/*.capture.txt

# Build-time secret tool: holds plaintext master_password/api_url. Keep local only.
bot/encrypt_config.py

# Relogin batch: account inputs, backups, and its log all carry live LF_AC.
bot/input/
*_backup/
*.relogin.csv

# Shared rate-limit bucket/lock files written by workers at runtime.
bot/.ratelimit/
